    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Closet Match</fullName>
                <default>false</default>
                <label>Closet Match</label>
            </value>
            <value>
                <fullName>Fallback Message</fullName>

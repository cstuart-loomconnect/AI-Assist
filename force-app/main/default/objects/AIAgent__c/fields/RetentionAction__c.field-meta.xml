<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RetentionAction__c</fullName>
    <description>What happens to this Agent&apos;s conversations once they pass their Retention Expiry Date.</description>
    <inlineHelpText>Archive keeps the conversation and its messages but marks them archived. Anonymize additionally strips message content and record-level identifiers.</inlineHelpText>
    <label>Retention Action</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Archive</fullName>
                <default>false</default>
                <label>Archive</label>
            </value>
            <value>
                <fullName>Anonymize</fullName>
                <default>false</default>
                <label>Anonymize</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>

<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SectionWidth__c</fullName>
    <description>How much of the page row a Component or Related List section takes. Sections flow left to right in Display Order, three columns to a row.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <inlineHelpText>Full takes the whole row. Two Thirds and One Third sit side by side. Ignored for Sub Navigation sections.</inlineHelpText>
    <label>Section Width</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Full</fullName>
                <default>true</default>
                <label>Full</label>
            </value>
            <value>
                <fullName>Two Thirds</fullName>
                <default>false</default>
                <label>Two Thirds</label>
            </value>
            <value>
                <fullName>One Third</fullName>
                <default>false</default>
                <label>One Third</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>

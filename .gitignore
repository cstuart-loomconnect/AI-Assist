# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Credentials and testing-only permission sets - deployed to scratch and demo orgs, never committed
force-app/main/default/externalCredentials/
force-app/main/default/namedCredentials/
force-app/main/default/permissionsets/Test_Anthropic.permissionset-meta.xml

# Demo / testing-only Apex - deployed to scratch and demo orgs, never committed
force-app/main/default/classes/AIDemoOrgSetup.cls
force-app/main/default/classes/AIDemoOrgSetup.cls-meta.xml
force-app/main/default/classes/AIConversationSimulator.cls
force-app/main/default/classes/AIConversationSimulator.cls-meta.xml
force-app/main/default/classes/AIConversationScenarioStep.cls
force-app/main/default/classes/AIConversationScenarioStep.cls-meta.xml
force-app/main/default/classes/AiDataSourceDemoExecutor.cls
force-app/main/default/classes/AiDataSourceDemoExecutor.cls-meta.xml
